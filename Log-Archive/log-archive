#!/bin/bash

LOG_DIR="$1"

if [ -z "$LOG_DIR" ]; then
    echo "Usage: $0 <log-directory>"
    exit 1
fi

if [ ! -d "$LOG_DIR" ]; then
    echo "Error: directory does not exist: $LOG_DIR"
    exit 1
fi

if [ ! -r "$LOG_DIR" ]; then
    echo "Error: cannot read $LOG_DIR"
    echo "Try running the command with sudo."
    exit 1
fi

ARCHIVE_DIR="./log-archives"
mkdir -p "$ARCHIVE_DIR"

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
ARCHIVE_NAME="logs_archive_${TIMESTAMP}.tar.gz"
ARCHIVE_PATH="$ARCHIVE_DIR/$ARCHIVE_NAME"

if tar -czf "$ARCHIVE_PATH" "$LOG_DIR"; then
    echo "[$TIMESTAMP] Created $ARCHIVE_NAME" >> "$ARCHIVE_DIR/archive.log"
    echo "Archive created: $ARCHIVE_PATH"
else
    echo "Error: failed to create archive"
    rm -f "$ARCHIVE_PATH"
    exit 1
fi